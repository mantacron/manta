#!/usr/bin/env bash
# Manta Pre-Commit Hook
# Runs multi-agent code review on staged changes.
# Blocks commit if CRITICAL issues are found.
# Supports: Claude Code (claude), OpenAI Codex CLI (codex), Google Gemini CLI (gemini)
#
# Setup: run scripts/setup.sh (or: git config core.hooksPath .githooks)

set -euo pipefail

# ─── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# ─── AI tool detection ────────────────────────────────────────────────────────
# Supports: Claude Code (claude), OpenAI Codex CLI (codex), Google Gemini CLI (gemini)
# Override with: AI_BIN=gemini git commit
# Model override: MANTA_MODEL=opus git commit|push (default: sonnet — review agents pin
# their own models in frontmatter; this only sets the orchestrator's model)
# Legacy override: CLAUDE_BIN=claude git commit

detect_ai_tool() {
  if [[ -n "${AI_BIN:-}" ]] && command -v "$AI_BIN" &>/dev/null; then
    echo "$AI_BIN"; return
  fi
  if [[ -n "${CLAUDE_BIN:-}" ]] && command -v "${CLAUDE_BIN}" &>/dev/null; then
    echo "${CLAUDE_BIN}"; return
  fi
  if command -v claude &>/dev/null; then echo "claude"; return; fi
  if command -v codex &>/dev/null; then echo "codex"; return; fi
  if command -v gemini &>/dev/null; then echo "gemini"; return; fi
  echo ""
}

run_ai_review() {
  local tool="$1"
  local prompt="$2"
  local hook_timeout="${3:-120}"
  case "$tool" in
    claude) timeout "$hook_timeout" claude --print --model "${MANTA_MODEL:-sonnet}" "$prompt" 2>&1 ;;
    codex)  timeout "$hook_timeout" codex -q "$prompt" 2>&1 ;;
    gemini) timeout "$hook_timeout" gemini -p "$prompt" 2>&1 ;;
    *)      return 1 ;;
  esac
}

AI_TOOL=$(detect_ai_tool)

# ─── Locate Manta directory ───────────────────────────────────────────────────
# Works whether Manta is at the project root or in a subfolder (e.g. project/manta/)
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANTA_DIR="$(cd "$HOOK_DIR/.." && pwd)"
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Every gap in review coverage lands here, in one format: explicit bypasses and
# fail-closed conditions alike. Both mean a commit happened without a verdict,
# so both belong in the same audit trail. Kept as human-readable text on purpose
# — the self-test, the e2e runner, and the docs treat this file as readable.
log_bypass_event() {
  local event="$1" detail="$2"
  mkdir -p "$GIT_ROOT/reports" 2>/dev/null || true
  printf "[%s] pre-commit %s | branch: %s%s\n" \
    "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$event" \
    "$(git -C "$GIT_ROOT" branch --show-current 2>/dev/null || echo unknown)" \
    "${detail:+ | $detail}" \
    >> "$GIT_ROOT/reports/.bypass-log"
}

log_review_failure() {
  log_bypass_event "review FAILED — commit BLOCKED, no verdict produced" "reason: $1"
}

# ─── Config ───────────────────────────────────────────────────────────────────
CLAUDE_BIN="${CLAUDE_BIN:-claude}"  # kept for backward compat
# Measured against demo/ (5 files, 4 agents, findings in each): a real review
# takes ~450s. The old 120s default was under a quarter of that, and since the
# review fails closed, an over-tight budget turns "slow" into "commit blocked"
# with no finding to show for it — the worst failure mode this hook has.
# Override per-repo or per-commit with CLAUDE_HOOK_TIMEOUT.
HOOK_TIMEOUT="${CLAUDE_HOOK_TIMEOUT:-480}"  # seconds before giving up (whole review)
SKIP_VAR="SKIP_CLAUDE_REVIEW"

# Per-agent timeout budgets are specified directly in pre-commit-review.md's
# Step 3 table, which the orchestrating agent reads as part of the prompt —
# not via env vars (there used to be dead AGENT_TIMEOUT_* exports here that
# nothing ever read; removed to avoid the false impression they're tunable).

# ─── Skip check ───────────────────────────────────────────────────────────────
if [[ "${!SKIP_VAR:-}" == "1" ]]; then
  # An explicit bypass is a legitimate escape hatch, but it must leave a trace.
  # This branch used to exit silently, so commit-level bypasses were invisible
  # while push-level ones were logged — the one asymmetry that made the audit
  # trail unusable as evidence.
  echo -e "${YELLOW}[manta]${RESET} Review skipped (${SKIP_VAR}=1) — logging bypass"
  log_bypass_event "review bypassed via ${SKIP_VAR}=1" ""
  exit 0
fi

# ─── Check AI tool is available ───────────────────────────────────────────────
if [[ -z "$AI_TOOL" ]]; then
  echo -e "${YELLOW}[manta]${RESET} Warning: no AI CLI found — skipping review"
  echo "         Install one of: claude (npm i -g @anthropic-ai/claude-code), codex (npm i -g @openai/codex), gemini (npm i -g @google/gemini-cli)"
  echo "         Or set SKIP_CLAUDE_REVIEW=1 to bypass"
  exit 0
fi

# ─── Check for staged files ────────────────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null)
if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

# ─── Skip non-code files only commits ─────────────────────────────────────────
STAGED_CODE_FILES=$(git diff --cached --name-only | grep -E '\.(ts|tsx|js|jsx|mjs|cjs|py|go|rs|rb|java|kt|swift|c|cpp|h|hpp|cs|php|sh|bash)$' || true)
if [[ -z "$STAGED_CODE_FILES" ]]; then
  echo -e "${CYAN}[manta/${AI_TOOL}]${RESET} Only non-code files staged — skipping code review"
  exit 0
fi

# ─── Run review ───────────────────────────────────────────────────────────────
echo ""
echo -e "${CYAN}${BOLD}┌─────────────────────────────────────────────────┐${RESET}"
echo -e "${CYAN}${BOLD}│           Manta Pre-Commit Review               │${RESET}"
echo -e "${CYAN}${BOLD}└─────────────────────────────────────────────────┘${RESET}"
echo ""
echo -e "${CYAN}[manta/${AI_TOOL}]${RESET} Reviewing $(echo "$STAGED_CODE_FILES" | wc -l | tr -d ' ') staged file(s)..."

# ─── Shallow pre-scan ─────────────────────────────────────────────────────────
SHALLOW_RESULT=""
if [[ -f "$MANTA_DIR/scripts/shallow-scan.sh" ]]; then
  SHALLOW_RESULT=$(cd "$GIT_ROOT" && bash "$MANTA_DIR/scripts/shallow-scan.sh" 2>/dev/null || true)
  SHALLOW_STATUS=$(echo "$SHALLOW_RESULT" | grep "^SHALLOW_SCAN:" | cut -d' ' -f2 || echo "UNKNOWN")
  SIGNAL_COUNT=$(echo "$SHALLOW_RESULT" | grep "^SIGNALS:" | cut -d' ' -f2 || echo "0")

  if [[ "$SHALLOW_STATUS" == "SIGNALS_FOUND" ]]; then
    echo -e "${YELLOW}[manta]${RESET} Shallow scan: ${SIGNAL_COUNT} signal(s) — running full agent review"
  else
    echo -e "${GREEN}[manta]${RESET} Shallow scan: clean — running optimized review"
  fi
fi

# ─── Project map ─────────────────────────────────────────────────────────────
if [[ -f "$MANTA_DIR/scripts/build-project-map.sh" ]]; then
  cd "$GIT_ROOT" && bash "$MANTA_DIR/scripts/build-project-map.sh" > /dev/null 2>&1 || true
fi

echo -e "${CYAN}[manta/${AI_TOOL}]${RESET} Running: security-sentinel, code-quality, db-migration-guardian"
echo ""

# Build the review prompt — prepend shallow scan results so agents don't re-run it
REVIEW_PROMPT=$(cat "$MANTA_DIR/.claude/commands/pre-commit-review.md" 2>/dev/null || echo "Review the staged git changes. Check for critical issues in code quality, security vulnerabilities, and performance. Output COMMIT_VERDICT: PASS or COMMIT_VERDICT: BLOCK.")

if [[ -n "$SHALLOW_RESULT" ]]; then
  REVIEW_PROMPT="$(printf '## Shallow Pre-Scan Results\n\n%s\n\n---\n\n%s' "$SHALLOW_RESULT" "$REVIEW_PROMPT")"
fi

# Run AI review
REVIEW_OUTPUT=""
CLAUDE_EXIT=0

REVIEW_OUTPUT=$(
  cd "$MANTA_DIR" && \
  GIT_DIR="$GIT_ROOT/.git" GIT_WORK_TREE="$GIT_ROOT" \
  run_ai_review "$AI_TOOL" "$REVIEW_PROMPT" "$HOOK_TIMEOUT"
) || CLAUDE_EXIT=$?

# ─── Handle timeout or error (fail-closed) ────────────────────────────────────
# A review that didn't finish can't vouch for the commit — treat it the same
# as a BLOCK, not a PASS. Bypass must be explicit (SKIP_CLAUDE_REVIEW=1) so the
# gap is a visible, logged decision instead of a silent default.
if [[ $CLAUDE_EXIT -eq 124 ]]; then
  log_review_failure "timeout after ${HOOK_TIMEOUT}s"
  echo ""
  echo -e "${RED}${BOLD}[manta] Review timed out after ${HOOK_TIMEOUT}s — commit BLOCKED (fail-closed)${RESET}"
  echo "         The review did not complete, so it cannot clear this commit."
  echo "         Raise the budget: export CLAUDE_HOOK_TIMEOUT=900"
  echo "         Bypass (emergency only, logged): SKIP_CLAUDE_REVIEW=1 git commit"
  exit 1
fi

if [[ $CLAUDE_EXIT -ne 0 ]] && ! grep -qE '^[[:space:]]*COMMIT_VERDICT:' <<<"$REVIEW_OUTPUT"; then
  log_review_failure "error: exit ${CLAUDE_EXIT}"
  echo ""
  echo -e "${RED}${BOLD}[manta] Review encountered an error — commit BLOCKED (fail-closed)${RESET}"
  echo "         Error: $REVIEW_OUTPUT" | head -5
  echo "         Bypass (emergency only, logged): SKIP_CLAUDE_REVIEW=1 git commit"
  exit 1
fi

# ─── Display review output ────────────────────────────────────────────────────
echo "$REVIEW_OUTPUT"
echo ""

# ─── Save review to reports/ ──────────────────────────────────────────────────
REPORT_DATE=$(date +%Y-%m-%d)
REPORT_TIME=$(date +%H%M%S)   # seconds included: %H%M collided for two commits in one minute
REPORT_FILE="$GIT_ROOT/reports/${REPORT_DATE}-${REPORT_TIME}-commit-review.md"
mkdir -p "$GIT_ROOT/reports"
{
  printf "# Pre-Commit Review — %s %s\n\n" "$REPORT_DATE" "$(date +%H:%M)"
  printf "**Branch**: \`%s\`  \n" "$(git -C "$GIT_ROOT" branch --show-current 2>/dev/null)"
  printf "**Files reviewed**: %s\n\n" "$(echo "$STAGED_CODE_FILES" | wc -l | tr -d ' ')"
  printf "**Staged files**:\n\`\`\`\n%s\n\`\`\`\n\n" "$STAGED_CODE_FILES"
  printf '%s\n\n' "---"
  printf "%s\n" "$REVIEW_OUTPUT"
} > "$REPORT_FILE"
echo -e "${CYAN}[manta]${RESET} Review saved: ${REPORT_FILE}"
echo ""

# ─── Parse verdict ────────────────────────────────────────────────────────────
# Resolve the verdict exactly once, from an anchored match on its own line.
# An unanchored search matches the string anywhere in the output — including
# inside a finding that happens to quote it, which is routine whenever the
# reviewed code is itself a review pipeline. That turned a PASS into a BLOCK.
# BLOCK_REASON takes the last match for the same reason.
if   grep -qE '^[[:space:]]*COMMIT_VERDICT: BLOCK' <<<"$REVIEW_OUTPUT"; then VERDICT=BLOCK
elif grep -qE '^[[:space:]]*COMMIT_VERDICT: WARN'  <<<"$REVIEW_OUTPUT"; then VERDICT=WARN
elif grep -qE '^[[:space:]]*COMMIT_VERDICT: PASS'  <<<"$REVIEW_OUTPUT"; then VERDICT=PASS
else VERDICT=""; fi

VERDICT_REASON=$(grep -E '^[[:space:]]*BLOCK_REASON:' <<<"$REVIEW_OUTPUT" | tail -1 | sed 's/^[[:space:]]*BLOCK_REASON: //' || true)

if [[ "$VERDICT" == "BLOCK" ]]; then
  BLOCK_REASON="${VERDICT_REASON:-Critical issues found}"

  echo ""
  echo -e "${RED}${BOLD}╔═══════════════════════════════════════════════════╗${RESET}"
  echo -e "${RED}${BOLD}║              COMMIT BLOCKED 🚫                   ║${RESET}"
  echo -e "${RED}${BOLD}╚═══════════════════════════════════════════════════╝${RESET}"
  echo ""
  echo -e "${RED}${BOLD}$BLOCK_REASON${RESET}"
  echo ""
  echo -e "${YELLOW}Fix the critical issues above, then commit again.${RESET}"
  echo -e "${CYAN}Get AI fix suggestions:${RESET} open Claude Code (${BOLD}/fix${RESET}) or ask your AI assistant"
  echo ""
  echo -e "To bypass (emergency only): ${BOLD}SKIP_CLAUDE_REVIEW=1 git commit${RESET}"
  echo ""
  exit 1

elif [[ "$VERDICT" == "WARN" ]]; then
  WARN_REASON="${VERDICT_REASON:-Warnings found}"

  echo ""
  echo -e "${YELLOW}${BOLD}╔═══════════════════════════════════════════════════╗${RESET}"
  echo -e "${YELLOW}${BOLD}║          COMMIT ALLOWED — WARNINGS ⚠             ║${RESET}"
  echo -e "${YELLOW}${BOLD}╚═══════════════════════════════════════════════════╝${RESET}"
  echo ""
  echo -e "${YELLOW}${BOLD}$WARN_REASON${RESET}"
  echo ""
  echo -e "${YELLOW}Warnings above should be addressed before pushing.${RESET}"
  echo -e "${CYAN}Get AI fix suggestions:${RESET} open Claude Code (${BOLD}/fix${RESET}) or ask your AI assistant"
  echo -e "${YELLOW}Note:${RESET} Warnings ${BOLD}will block${RESET} the pre-push review."
  echo ""
  exit 0

elif [[ "$VERDICT" == "PASS" ]]; then
  echo -e "${GREEN}${BOLD}✅ Review passed — proceeding with commit${RESET}"
  echo ""
  exit 0

else
  # Review ran but produced no parseable verdict — same fail-closed rule as
  # timeout/error: an unreadable result is not a pass.
  log_review_failure "unparseable verdict"
  echo ""
  echo -e "${RED}${BOLD}[manta] Review ran but produced no parseable verdict — commit BLOCKED (fail-closed)${RESET}"
  echo "         Run /review in Claude Code for a full interactive review"
  echo "         Bypass (emergency only, logged): SKIP_CLAUDE_REVIEW=1 git commit"
  exit 1
fi
